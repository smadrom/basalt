# syntax=docker/dockerfile:1
# Basalt web image — Vite build served by nginx. Build context is the monorepo root:
#   docker build -f docker/Dockerfile.web -t basalt-web:latest .
#
# Build args:
#   VITE_API_URL  API base URL baked into the bundle (default "" = same origin)
#   NGINX_CONF    server config copied into the image; docker/nginx/spa.conf for
#                 Traefik-fronted deploys, docker/nginx/spa-api-proxy.conf when
#                 nginx itself must proxy /api (docker-compose.prod.yml)
FROM oven/bun:1 AS build

WORKDIR /app

COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN bun install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web

ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

# vite build only — typecheck is a CI gate (tsc would need the API sources too).
WORKDIR /app/apps/web
RUN bunx vite build

FROM nginx:alpine

ARG NGINX_CONF=docker/nginx/spa.conf
COPY $NGINX_CONF /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
